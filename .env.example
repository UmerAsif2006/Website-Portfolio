# n8n webhook URLs used by the portfolio (browser-safe, public endpoints).
# Copy this file to .env and fill in your own values.

# Chat + voice demos POST {"action":"sendMessage","sessionId","chatInput"} here.
VITE_N8N_CHAT_WEBHOOK_URL=

# Contact form POSTs {timestamp,name,email,subject,message,source} here.
VITE_N8N_CONTACT_WEBHOOK_URL=
